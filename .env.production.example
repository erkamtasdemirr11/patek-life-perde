# Canlı ortam (Hostinger) için örnek ayarlar.
# Sunucuda bu dosyayı .env adıyla kopyalayın ve boş alanları doldurun.
# .env dosyası asla Git'e eklenmez.

APP_NAME="Patek Life Perde"
APP_ENV=production
# Sunucuda üretin: php artisan key:generate --force
APP_KEY=
APP_DEBUG=false
# Alan adınız, https ile ve sonunda / olmadan
APP_URL=https://alanadiniz.com

APP_TIMEZONE=Europe/Istanbul
APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Günlük log dosyası (storage/logs/laravel-YYYY-MM-DD.log), 14 gün saklanır, yalnızca hatalar yazılır.
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# hPanel > Veritabanları > MySQL Veritabanları ekranındaki bilgiler
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Oturum çerezi yalnızca HTTPS üzerinden gönderilir.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Paylaşımlı hostingde kuyruk işçisi yok: işler anında çalışır.
QUEUE_CONNECTION=sync
CACHE_STORE=database

# E-posta gönderimi kullanılmıyor (şifre sıfırlama kapalı, 2FA uygulama tabanlı).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="bilgi@alanadiniz.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Fiş çıktısında ve sitede görünen firma bilgileri
FIRMA_ADI="Patek Life Perde"
FIRMA_ADRES="Ferah Cd. No: 49-51, Sultanbeyli / İstanbul"
FIRMA_TELEFON="+90 538 988 9012"
FIRMA_EPOSTA=""

# Tanıtım sitesi
# 90 ile başlayan, boşluksuz numara: 905321234567
SITE_WHATSAPP=
SITE_INSTAGRAM=
# Google Haritalar > Paylaş > Harita yerleştir > src adresi
SITE_HARITA_EMBED="https://www.google.com/maps?q=40.96389,29.26069&z=17&hl=tr&output=embed"

# Google Search Console dogrulama kodu (HTML etiketi yontemi)
GOOGLE_SITE_VERIFICATION=
